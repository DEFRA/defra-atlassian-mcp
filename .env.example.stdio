# Configuration for the stdio entry point (defra-atlassian-mcp).
#
# Copy to ~/.config/defra-atlassian-mcp/.env (or %APPDATA%\defra-atlassian-mcp\.env on
# Windows) and the server finds it with no flags, or pass it explicitly with
# --env-file. A .env in the working directory is never read. Variables set in
# the process environment (e.g. an MCP client's "env" block) take precedence.
#
# Keep this file private: it holds your API token. On macOS/Linux:
#   chmod 600 ~/.config/defra-atlassian-mcp/.env

# ---- Atlassian site and credentials
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-api-token

# "classic" (default): an API token without scopes; calls go to the site URL.
# "scoped": an API token with scopes; calls go through api.atlassian.com, and
# the site's cloud id is looked up from ATLASSIAN_SITE_URL at startup. A scoped
# token needs at least the read scopes for the products you allow below.
# ATLASSIAN_API_TOKEN_TYPE=classic

# ---- Allowlist (REQUIRED: at least one of these must list one or more keys)
# Comma-separated, exact and case-sensitive. No wildcards.
# Jira project keys: upper case, e.g. FARM. Confluence space keys:
# alphanumeric, e.g. ENG (personal ~ spaces are not supported).
# Leave one empty to allow nothing in that product.
RESOURCE_GUARD_ALLOWED_JIRA_PROJECTS=FARM,AICE
RESOURCE_GUARD_ALLOWED_CONFLUENCE_SPACES=ENG

# ---- Optional
# On startup the server checks the credentials (an HTTP 401 stops it) and
# warns about listed keys that do not resolve. Set to true to start offline.
# A scoped token's cloud-id lookup still runs.
# ATLASSIAN_SKIP_STARTUP_CHECK=false
# DEBUG, INFO, WARNING or ERROR. Logs go to stderr.
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT_SECONDS=30
# HTTP_PROXY=http://proxy.example.com:3128
