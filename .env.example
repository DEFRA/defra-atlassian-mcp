# ---- App ----
BASE_URL=http://localhost:8085
SERVER_NAME=atlassian-mcp
HOST=127.0.0.1
PORT=8085
# PYTHON_ENV=development
# LOG_CONFIG=logging-dev.json

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
# MONGO_TRUSTSTORE=TRUSTSTORE_CDP_ROOT_CA

# ---- Resource guard ----
# "config_list" (default) denies a space unless its key is listed, per
# product, in RESOURCE_GUARD_ALLOWED_JIRA_PROJECTS /
# RESOURCE_GUARD_ALLOWED_CONFLUENCE_SPACES below -- a key listed for Jira
# still grants nothing in Confluence. This list is hand-managed config, set
# directly here by an operator; it has nothing to do with the
# access-request/admin-approval workflow further down.
# "allow_list" denies a space unless an approved SpaceAccessRequest exists
# for the (user, space, product) triple instead -- flip to it only once the
# admin surface has real approvals to check against, since flipping first
# denies all traffic.
# "allow_all" lets every Jira/Confluence request through; the access-request
# workflow below still records requests and decisions but nothing is
# enforced.
RESOURCE_GUARD_MODE=config_list
# Both of these are required -- the server fails to start if either is
# missing entirely. An empty value is fine (that product is simply denied
# under config_list mode) but logs a warning, since a var left empty by
# accident silently locks everyone out.
RESOURCE_GUARD_ALLOWED_JIRA_PROJECTS=
RESOURCE_GUARD_ALLOWED_CONFLUENCE_SPACES=

# ---- Identity: this server mints and verifies its own personal access
# tokens (PATs). There is no external IdP call on the request path -- the
# portal authenticates the user against Entra on its own, then calls this
# server's trusted-header surface to mint a token, and hands that token to
# the user for one-time viewing.
#
# REST_AUTH_MODE governs the admin/REST surface (not /mcp, which always
# requires a bearer PAT):
#   trusted (default) - no token auth; trust the caller to assert the user via
#                        TRUSTED_USER_HEADER. Use only when this surface is on
#                        a locked-down backend network reachable solely from
#                        the portal.
#   token              - require a bearer PAT, same as /mcp.
# The token-mint/list/revoke surface (POST/GET/DELETE /tokens) always uses
# the trusted header regardless of this setting.
REST_AUTH_MODE=trusted
TRUSTED_USER_HEADER=X-User-Id

# IDENTITY_DEFAULT_TTL_DAYS=90
# IDENTITY_MAX_TTL_DAYS=365
# IDENTITY_LAST_USED_THROTTLE_SECONDS=300

# ---- Atlassian OAuth 2.0 3LO (server -> Jira/Confluence) ----
# ATLASSIAN_AUTH_BASE=https://auth.atlassian.com
# ATLASSIAN_API_BASE=https://api.atlassian.com
ATLASSIAN_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret
# The callback URL registered on the Atlassian OAuth app. It is an absolute
# URL and it belongs to the *portal*, not to this server: Atlassian redirects
# the browser to the portal, which forwards the code and state to this
# server's GET /linking/callback.
ATLASSIAN_REDIRECT_URI=http://localhost:3000/account/atlassian-linking/callback

# Local dev auth: no bypass. Mint a token against the running service --
#   curl -XPOST localhost:8085/tokens -H "X-User-Id: dev@example.com" -d '{"label":"local"}'
# and use the returned token as a Bearer token against /mcp or any other route.
